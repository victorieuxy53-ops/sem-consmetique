# Variables d'environnement — copiez ce fichier en « .env.local » (en local) ou saisissez-les
# dans Vercel › Project › Settings › Environment Variables. Aucune n'est obligatoire pour que le site s'affiche.

# Compte administrateur créé au premier démarrage (INDISPENSABLE en ligne : sur Vercel, sans ces deux
# variables, l'espace /admin est verrouillé par un mot de passe aléatoire).
ADMIN_EMAIL=patronne@exemple.com
ADMIN_PASSWORD=ChoisissezUnMotDePasseLong!

# Adresse publique du site (aperçus de partage WhatsApp / Facebook). Facultatif sur Vercel (domaine détecté).
SITE_URL=https://www.exemple.com

# Dossier des données (base SQLite, photos, vidéos). Par défaut : ./data en local, /tmp sur Vercel (éphémère).
# Sur un serveur avec disque persistant (VPS), indiquez un chemin absolu sauvegardé régulièrement.
# DATA_DIR=/var/lib/sem-cosmetique

# Derrière un proxy HTTPS (Nginx…) : 1. Activés automatiquement sur Vercel.
# TRUST_PROXY=1
# SECURE_COOKIES=1

# Port d'écoute pour « npm start » (défaut 3000). Ignoré par Vercel.
# PORT=3000
