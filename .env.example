# Variables d'environnement — copiez ce fichier en « .env.local » (en local) ou saisissez-les dans
# Vercel › Project › Settings › Environment Variables. Après toute modification sur Vercel : Redeploy.

# ---------------------------------------------------------------- Administratrice
# Mot de passe de l'espace /admin (INDISPENSABLE en ligne : sans lui, /admin reste verrouillé).
# Il est appliqué automatiquement au démarrage suivant (une fois par nouvelle valeur).
ADMIN_PASSWORD=ChoisissezUnMotDePasseLong!
# Numéro de téléphone de connexion (par défaut : le numéro WhatsApp principal du site).
# ADMIN_PHONE=01 63 40 35 39
# E-mail de connexion (facultatif).
# ADMIN_EMAIL=patronne@exemple.com

# ---------------------------------------------------------------- Données permanentes en ligne
# Base Turso : posées AUTOMATIQUEMENT quand on connecte une base Turso au projet (Vercel › Storage).
# Sans elles, sur Vercel, les modifications faites dans l'admin sont perdues au redémarrage.
# TURSO_DATABASE_URL=libsql://xxxx.turso.io
# TURSO_AUTH_TOKEN=eyJ...
# Stockage des photos et vidéos : posé AUTOMATIQUEMENT quand on connecte un store Vercel Blob au projet.
# BLOB_STORE_ID=store_...                 (stores récents : accès sans jeton, via OIDC Vercel)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_... (anciens stores)

# ---------------------------------------------------------------- Divers
# Adresse publique du site (aperçus de partage WhatsApp / Facebook). Facultatif sur Vercel (domaine détecté).
# SITE_URL=https://www.exemple.com
# Dossier des données locales (base SQLite, photos, vidéos) hors Turso / Blob. Par défaut : ./data (/tmp sur Vercel).
# DATA_DIR=/var/lib/sem-cosmetique
# Derrière un proxy HTTPS (Nginx…) : 1. Activés automatiquement sur Vercel.
# TRUST_PROXY=1
# SECURE_COOKIES=1
# Port d'écoute pour « npm start » (défaut 3000). Ignoré par Vercel.
# PORT=3000
